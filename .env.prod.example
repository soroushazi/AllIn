# Copy this to .env.prod on the Oracle instance and fill in real values.
# .env.prod is gitignored - never commit it.

# The domain pointed at this instance's public IP (A record). Caddy uses
# this both to route requests and to request its Let's Encrypt certificate.
DOMAIN=jiring.example.com

# Postgres - pick a real, strong password (this is NOT the local dev default).
POSTGRES_DB=jiring
POSTGRES_USER=jiring
POSTGRES_PASSWORD=change-me-to-a-real-password

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=jiring.example.com
CORS_ALLOWED_ORIGINS=https://jiring.example.com
CSRF_TRUSTED_ORIGINS=https://jiring.example.com

# Optional - defaults shown. WHISPER_MODEL trades speed for accuracy on the
# ARM instance's CPU; OLLAMA_MODEL is Phi-3 Mini per CLAUDE.md's Stack
# decision (try llama3.1:8b if extraction accuracy is poor, but it's a much
# bigger model to run on a free-tier CPU box).
WHISPER_MODEL=base.en
OLLAMA_MODEL=phi3
